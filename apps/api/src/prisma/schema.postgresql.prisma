datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String        @id @default(uuid())
  cnic           String        @unique
  fullName       String
  email          String        @unique
  mobile         String        @unique
  role           String        @default("STUDENT")
  passwordHash   String
  isVerified     Boolean       @default(false)
  universityId   String?
  university     University?   @relation(fields: [universityId], references: [id])
  applications   Application[] @relation("StudentApplications")
  verifiedApps   Application[] @relation("CoordinatorVerifications")
  supportTickets SupportTicket[]
  notifications  Notification[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model University {
  id             String        @id @default(uuid())
  name           String        @unique
  city           String
  sector         String
  province       String        @default("Punjab")
  hecRecognized  Boolean       @default(true)
  hecReferenceNo String?
  isActive       Boolean       @default(true)
  users          User[]
  applications   Application[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Application {
  id                     String           @id @default(uuid())
  applicationNo          String           @unique
  studentId              String
  student                User             @relation("StudentApplications", fields: [studentId], references: [id])
  universityId           String
  university             University       @relation(fields: [universityId], references: [id])
  
  dob                    String
  gender                 String
  fatherName             String
  address                String
  domicileDistrict       String
  licenseNumber          String
  licenseType            String
  licenseExpiry          String
  
  degreeProgram          String
  rollNumber             String
  currentSemester        Int
  cgpa                   Float?
  attendanceRate         Float
  isRegularStudent       Boolean          @default(true)
  hasProbation           Boolean          @default(false)
  
  bankIban               String?
  walletType             String           @default("BANK_ACCOUNT")
  walletNumber           String?
  householdMonthlyIncome Float
  isDifferentlyAbled     Boolean          @default(false)
  signatureName          String
  
  status                 String           @default("SUBMITTED")
  rejectionReason        String?
  rejectionRemarks       String?
  verifiedAt             DateTime?
  verifiedById           String?
  verifiedBy             User?            @relation("CoordinatorVerifications", fields: [verifiedById], references: [id])
  selectedAt             DateTime?
  lotteryDrawId          String?
  
  documents              Document[]
  payments               Payment[]
  bikeAllocation         BikeAllocation?
  supportTickets         SupportTicket[]
  
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model Document {
  id            String       @id @default(uuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  docType       String
  filePath      String
  originalName  String
  mimeType      String
  size          Int
  status        String       @default("UPLOADED")
  verifiedAt    DateTime?
  createdAt     DateTime     @default(now())
}

model Payment {
  id                String       @id @default(uuid())
  applicationId     String
  application       Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amount            Float
  installmentNumber Int
  dueDate           DateTime
  paidDate          DateTime?
  status            String       @default("PENDING")
  transactionRef    String?
  createdAt         DateTime     @default(now())
}

model BikeAllocation {
  id                  String       @id @default(uuid())
  applicationId       String       @unique
  application         Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  dealerId            String?
  centerName          String
  bikeModel           String       @default("Roadmaster E-Glide 1000")
  frameNumber         String?
  batterySerialNumber String?
  registrationNumber  String?
  qrCodeToken         String       @unique
  status              String       @default("ALLOCATED")
  handoverDate        DateTime?
  remarks             String?
  createdAt           DateTime     @default(now())
}

model SchemeConfig {
  id                 String   @id @default("default-config")
  selectionMode      String   @default("LOTTERY")
  subsidyPercentage  Float    @default(50.0)
  maxQuota           Int      @default(10000)
  installmentMonths  Int      @default(24)
  monthlyInstallment Float    @default(4500)
  isActive           Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model SupportTicket {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  subject       String
  message       String
  priority      String       @default("NORMAL")
  status        String       @default("OPEN")
  response      String?
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  entity      String
  entityId    String
  action      String
  performedBy String
  detailsJson String?
  timestamp   DateTime @default(now())
}

model LotteryDraw {
  id                   String   @id @default(uuid())
  mode                 String
  totalSelected        Int
  executedBy           String
  anonymizedResultsJson String
  createdAt            DateTime @default(now())
}
